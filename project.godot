; Engine configuration file.

config_version=5

[application]

config/name="Traffic Escape"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/quit_on_go_back=false
config/icon="res://assets/icon.png"
boot_splash/bg_color=Color(0.749, 0.890, 0.949, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/icon.png"
boot_splash/fullsize=false

[autoload]

Sfx="*res://scripts/audio/sfx.gd"
Progress="*res://scripts/game/progress.gd"
ScreenFit="*res://scripts/ui/screen_fit.gd"
Transition="*res://scripts/ui/transition.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[internationalization]

locale/translations=PackedStringArray("res://translations/strings.en.translation", "res://translations/strings.tr.translation")
locale/fallback="en"
